# --- Anthropic (copy generation) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- GoHighLevel / LeadConnector ---
# Private Integration token for the Agent Lead Lab sub-account.
# Create under: Settings -> Private Integrations, with these scopes:
#   blogs/post.write, blogs/post-update.write, blogs/check-slug.readonly,
#   blogs/category.readonly, blogs/author.readonly, medias.write, medias.readonly
GHL_API_TOKEN=pit-...

# Agent Lead Lab sub-account location id (from the GHL URL: /v2/location/<THIS>/...)
GHL_LOCATION_ID=BKhr2W215aCl1bR6BHc5

# The "Agent Lead Lab Blogs" blog site id (from /blogs/site/<THIS>?tab=blog-posts)
GHL_BLOG_ID=vVS0DP09w5DdUY9AVVuA

# Optional: pin the author/category by id instead of resolving by name at runtime.
# GHL_AUTHOR_ID=
# GHL_CATEGORY_ID=

# --- YouTube Data API (the free, permanent fix) ---
# YouTube blocks anonymous scraping from datacenter IPs. The official API is not
# subject to that, because it authenticates. See the README for the click-path.

# Public data only: playlist listings and video titles. 2 minutes to set up.
YOUTUBE_API_KEY=

# Captions. Owner-only, so this needs OAuth consent given as the Agent Lead Lab
# channel. Mint the refresh token at developers.google.com/oauthplayground.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- The leads Google account (a different one from the channel's) ---------
# Counting the lead masterlists and writing the summary sheet. Its own
# credentials because captions are fetched as the YouTube channel's account and
# the Drive belongs to another - one refresh token could never do both, and
# re-minting the YouTube one for this would quietly break captions.
#
# Cloud Console -> the project for it -> OAuth consent screen (Internal) ->
# Credentials -> OAuth client ID (Web application) with
# https://developers.google.com/oauthplayground as a redirect URI. Then mint the
# refresh token at the playground with these scopes:
#   https://www.googleapis.com/auth/spreadsheets
#   https://www.googleapis.com/auth/drive.file
LEADS_GOOGLE_CLIENT_ID=
LEADS_GOOGLE_CLIENT_SECRET=
LEADS_GOOGLE_REFRESH_TOKEN=

# The sheet the lead summary is written into - the long id from its URL.
LEADS_SUMMARY_SHEET_ID=

# The Discord server the lead masterlist channels live in. A different server
# from the one RYTE is spoken to in, so it needs its own invite: View Channels
# and Read Message History, and nothing else - it has no business posting there.
# Right-click the server -> Copy Server ID (Developer Mode on).
LEADS_GUILD_ID=

# --- YouTube cookies: the route that actually beats the bot check ---
# "Sign in to confirm you're not a bot" applies to anonymous requests. Sending
# a signed-in one gets past it, and unlike the Data API this works for captions
# that were made in YouTube Studio rather than uploaded through the API.
#
# Export with the "Get cookies.txt LOCALLY" browser extension while logged in
# to youtube.com, open the file, and paste the whole thing here. Any account
# works - it does NOT have to own the channel, so a throwaway one is safer.
YOUTUBE_COOKIES=

# Or point at a cookies.txt already on disk (useful when self-hosting):
# YOUTUBE_COOKIES_FILE=/data/cookies.txt

# --- YouTube transcripts, fallback routes (not needed if the API is set up) ---
# YouTube blocks datacenter IPs for transcript requests, so a bot on Railway or
# similar works for a few calls and then gets refused. A residential proxy fixes
# it. Webshare's "Residential" plan is the one youtube-transcript-api supports
# directly - use the Proxy Username/Password from their dashboard, NOT your
# account login.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=

# Or any other proxy, as a single URL:
# YOUTUBE_PROXY_URL=http://user:pass@host:port

# --- Discord bot ---
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# Your server id (right-click the server -> Copy Server ID, with Developer Mode on).
# Optional, but without it new slash commands take up to an hour to appear.
DISCORD_GUILD_ID=

# Optional allowlists, comma-separated ids. Leave blank to allow everywhere/everyone.
# DISCORD_CHANNEL_IDS=123456789012345678
# DISCORD_ROLE_IDS=

# --- Watch a channel for new videos (optional) -------------------------------
# Channel ids where a new YouTube link should automatically become a blog post.
# Typically an #announcements channel a "new video" bot posts into.
#
# This needs the MESSAGE CONTENT INTENT, because RYTE has to read messages that
# don't mention it: discord.com/developers -> your app -> Bot -> Message
# Content Intent -> on. Without it Discord delivers those messages blank and
# the watcher sees nothing.
#
# RYTE also has to be a member of that server with permission to read the
# channel - being in your other server is not enough.
DISCORD_WATCH_CHANNEL_IDS=
# Where the review card goes. Leave blank to use the first DISCORD_CHANNEL_IDS
# entry. It should not be the watched channel - that one is a broadcast feed.
DISCORD_POST_CHANNEL_ID=

# Where new sales-call cards are announced. Optional - without it they
# go to the first channel RYTE is allowed to speak in.
DISCORD_RECORDINGS_CHANNEL_ID=

# File every new Zoom/Fathom call automatically, without anyone posting
# a link. Off by default: calls are usually reviewed first, and this
# would file the ones that were looked at and turned down.
RECORDINGS_AUTOFILE=false123456789012345678

# @mentions deliver message content without the privileged intent, so this stays
# off. Set to true only if you enabled Message Content in the developer portal.
# DISCORD_MESSAGE_CONTENT=false

# --- Deployment (set by the Dockerfile; override only if self-hosting) ---
# WILBYTE_HOME=/app              where config/, prompts/ and assets/ live
# WILBYTE_STATE_DIR=/data/state  the ledger - put this on a persistent volume
# WILBYTE_OUTPUT_DIR=/data/out   rendered posts and cover images
# WILBYTE_CORPUS_DIR=/data/corpus  the copy library - also needs the volume

# --- Notion: sales call recordings (optional) --------------------------------
# Tag RYTE on a posted Zoom/Fathom/YouTube recording and it files it in Notion
# as a gallery card with the link, the passcode and a summary.
#
# Token: notion.so/my-integrations -> New integration -> Internal Integration
# Secret. Then open the Sales Calls Recording page -> ... -> Connections -> add
# it. Notion answers 404 the same way for "not shared" and "doesn't exist", so
# skipping that step looks like a wrong page id.
# NOTION_TOKEN=ntn_...
# The page the gallery lives on - the id is the last part of its URL.
# NOTION_RECORDINGS_PAGE_ID=1234abcd5678efgh9012ijkl3456mnop
# Optional cover image for each card, so the gallery matches the other pages.
# Cover and icon for each card. Must be permanent public URLs - Notion never
# re-hosts them, so an expiring link leaves the cards blank later. `@RYTE host`
# with an image attached returns one from the GHL media library.
# NOTION_COVER_URL=https://assets.cdn.filesafe.space/.../headquarters.png
# NOTION_ICON_URL=https://assets.cdn.filesafe.space/.../leadlab-logo.png

# --- Zoom: reading a posted sales call (optional) -----------------------------
# The share link is a browser door with a passcode on it. The API is a
# different door, authenticated as the account, and it hands over the
# transcript Zoom generated when the call was recorded.
#
# marketplace.zoom.us -> Develop -> Build App -> Server-to-Server OAuth.
# Scopes (read-only): cloud_recording:read:list_account_recordings:admin and
# cloud_recording:read:list_user_recordings:admin. Activate the app - a built
# but inactive app fails exactly like a wrong secret.
#
# Then: zoom.us -> Settings -> Recording -> Advanced cloud recording ->
# **Create audio transcript** ON. Zoom does not generate transcripts
# retroactively, so calls recorded before this was switched on can never be
# summarised.
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=

# --- Fathom: the closer it records instead of Zoom (optional) -----------------
# Fathom sits in the meeting as a notetaker, so there is no passcode and no
# transcription setting that might have been off - if the call is in Fathom,
# its transcript exists. fathom.video -> Settings -> API.
# FATHOM_API_KEY=

# Card icon. An emoji is stored by Notion itself, so unlike a hosted image it
# cannot expire. Defaults to a microphone; NOTION_ICON_URL overrides it.
# NOTION_ICON_EMOJI=🎙️

# --- Trello, for the daily board routine ---
# Key and token from https://trello.com/power-ups/admin (make a Power-Up,
# then Generate a new API key, then the Token link beside it).
# The board id is the short code in the board's URL:
#   trello.com/b/<THIS_BIT>/agent-lead-lab
# The "Watching ..." line under RYTE's name in Discord. Leave it empty
# for none. Write it as "listening: sales calls" to pick the verb -
# watching, playing, listening or competing. "custom: busy being cute"
# shows the line with no verb in front of it.
DISCORD_ACTIVITY=

# --- The SOP library ---
# A Notion page to hold the SOP database, shared with the integration
# (page -> ... -> Connections). RYTE makes the database on first use.
NOTION_SOP_PAGE_ID=
# The Discord channel that feeds it. Everything posted there gets filed.
# The SOP library that already existed. Read once into a local index so
# RYTE can answer on it; never written to. Leave empty if it is the same
# page as NOTION_SOP_PAGE_ID.
NOTION_LIBRARY_PAGE_ID=

# The Discord channel that feeds it. Everything posted there gets filed.
DISCORD_SOP_CHANNEL_IDS=

TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
# Walk the board itself: In Que -> Today at 9am, Today -> Quality Check at 6pm,
# and at 9pm carry whatever is still unticked onto tomorrow's cards. Off unless
# set, because it writes to a board four people work off every day, on a timer,
# whether or not anybody is looking. Without it, `@RYTE trello rollover` still
# does the same thing on request.
TRELLO_AUTO=
# File new agents as they land in In Que, all day. Separate from TRELLO_AUTO:
# the board moves happen three times a day and this happens whenever a client
# signs, so wanting one is not wanting the other. Without it,
# `@RYTE trello agents` does the same thing on request.
TRELLO_AGENTS_AUTO=
# Where the board's own messages go. Falls back to DISCORD_POST_CHANNEL_ID.
DISCORD_BOARD_CHANNEL_ID=
