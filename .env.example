# --- Anthropic (copy generation) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- GoHighLevel / LeadConnector ---
# Private Integration token for the Agent Lead Lab sub-account.
# Create under: Settings -> Private Integrations, with these scopes:
#   blogs/post.write, blogs/post-update.write, blogs/check-slug.readonly,
#   blogs/category.readonly, blogs/author.readonly, medias.write, medias.readonly
GHL_API_TOKEN=pit-...

# Agent Lead Lab sub-account location id (from the GHL URL: /v2/location/<THIS>/...)
GHL_LOCATION_ID=BKhr2W215aCl1bR6BHc5

# The "Agent Lead Lab Blogs" blog site id (from /blogs/site/<THIS>?tab=blog-posts)
GHL_BLOG_ID=vVS0DP09w5DdUY9AVVuA

# Optional: pin the author/category by id instead of resolving by name at runtime.
# GHL_AUTHOR_ID=
# GHL_CATEGORY_ID=

# --- YouTube Data API (the free, permanent fix) ---
# YouTube blocks anonymous scraping from datacenter IPs. The official API is not
# subject to that, because it authenticates. See the README for the click-path.

# Public data only: playlist listings and video titles. 2 minutes to set up.
YOUTUBE_API_KEY=

# Captions, and the Levinson sales tracker. Owner-only, so this needs OAuth
# consent given as the Agent Lead Lab channel. Mint the refresh token at
# developers.google.com/oauthplayground.
#
# One token, two scopes. A token minted for YouTube alone will read captions
# and be refused by Sheets, so tick BOTH when you give consent:
#   https://www.googleapis.com/auth/youtube.force-ssl
#   https://www.googleapis.com/auth/spreadsheets
# Add Gmail's read scope to that same consent if RYTE is to fetch Summit Pay
# invoices for a chargeback rebuttal:
#   https://www.googleapis.com/auth/gmail.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- YouTube cookies: the route that actually beats the bot check ---
# "Sign in to confirm you're not a bot" applies to anonymous requests. Sending
# a signed-in one gets past it, and unlike the Data API this works for captions
# that were made in YouTube Studio rather than uploaded through the API.
#
# Export with the "Get cookies.txt LOCALLY" browser extension while logged in
# to youtube.com, open the file, and paste the whole thing here. Any account
# works - it does NOT have to own the channel, so a throwaway one is safer.
YOUTUBE_COOKIES=

# Or point at a cookies.txt already on disk (useful when self-hosting):
# YOUTUBE_COOKIES_FILE=/data/cookies.txt

# --- YouTube transcripts, fallback routes (not needed if the API is set up) ---
# YouTube blocks datacenter IPs for transcript requests, so a bot on Railway or
# similar works for a few calls and then gets refused. A residential proxy fixes
# it. Webshare's "Residential" plan is the one youtube-transcript-api supports
# directly - use the Proxy Username/Password from their dashboard, NOT your
# account login.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=

# Or any other proxy, as a single URL:
# YOUTUBE_PROXY_URL=http://user:pass@host:port

# --- Discord bot ---
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# Your server id (right-click the server -> Copy Server ID, with Developer Mode on).
# Optional, but without it new slash commands take up to an hour to appear.
DISCORD_GUILD_ID=

# Optional allowlists, comma-separated ids. Leave blank to allow everywhere/everyone.
# DISCORD_CHANNEL_IDS=123456789012345678
# DISCORD_ROLE_IDS=

# --- Watch a channel for new videos (optional) -------------------------------
# Channel ids where a new YouTube link should automatically become a blog post.
# Typically an #announcements channel a "new video" bot posts into.
#
# This needs the MESSAGE CONTENT INTENT, because RYTE has to read messages that
# don't mention it: discord.com/developers -> your app -> Bot -> Message
# Content Intent -> on. Without it Discord delivers those messages blank and
# the watcher sees nothing.
#
# RYTE also has to be a member of that server with permission to read the
# channel - being in your other server is not enough.
DISCORD_WATCH_CHANNEL_IDS=
# Where the review card goes. Leave blank to use the first DISCORD_CHANNEL_IDS
# entry. It should not be the watched channel - that one is a broadcast feed.
DISCORD_POST_CHANNEL_ID=

# Where new sales-call cards are announced. Optional - without it they
# go to the first channel RYTE is allowed to speak in.
DISCORD_RECORDINGS_CHANNEL_ID=

# File every new Zoom/Fathom call automatically, without anyone posting
# a link. Off by default: calls are usually reviewed first, and this
# would file the ones that were looked at and turned down.
RECORDINGS_AUTOFILE=false

# @mentions deliver message content without the privileged intent, so this stays
# off. Set to true only if you enabled Message Content in the developer portal.
# DISCORD_MESSAGE_CONTENT=false

# --- Deployment (set by the Dockerfile; override only if self-hosting) ---
# WILBYTE_HOME=/app              where config/, prompts/ and assets/ live
# WILBYTE_STATE_DIR=/data/state  the ledger - put this on a persistent volume
# WILBYTE_OUTPUT_DIR=/data/out   rendered posts and cover images
# WILBYTE_CORPUS_DIR=/data/corpus  the copy library - also needs the volume

# --- Notion: sales call recordings (optional) --------------------------------
# Tag RYTE on a posted Zoom/Fathom/YouTube recording and it files it in Notion
# as a gallery card with the link, the passcode and a summary.
#
# Token: notion.so/my-integrations -> New integration -> Internal Integration
# Secret. Then open the Sales Calls Recording page -> ... -> Connections -> add
# it. Notion answers 404 the same way for "not shared" and "doesn't exist", so
# skipping that step looks like a wrong page id.
# NOTION_TOKEN=ntn_...
# The page the gallery lives on - the id is the last part of its URL.
# NOTION_RECORDINGS_PAGE_ID=1234abcd5678efgh9012ijkl3456mnop
# Optional cover image for each card, so the gallery matches the other pages.
# Cover and icon for each card. Must be permanent public URLs - Notion never
# re-hosts them, so an expiring link leaves the cards blank later. `@RYTE host`
# with an image attached returns one from the GHL media library.
# NOTION_COVER_URL=https://assets.cdn.filesafe.space/.../headquarters.png
# NOTION_ICON_URL=https://assets.cdn.filesafe.space/.../leadlab-logo.png

# --- Zoom: reading a posted sales call (optional) -----------------------------
# The share link is a browser door with a passcode on it. The API is a
# different door, authenticated as the account, and it hands over the
# transcript Zoom generated when the call was recorded.
#
# marketplace.zoom.us -> Develop -> Build App -> Server-to-Server OAuth.
# Scopes (read-only): cloud_recording:read:list_account_recordings:admin and
# cloud_recording:read:list_user_recordings:admin. Activate the app - a built
# but inactive app fails exactly like a wrong secret.
#
# Then: zoom.us -> Settings -> Recording -> Advanced cloud recording ->
# **Create audio transcript** ON. Zoom does not generate transcripts
# retroactively, so calls recorded before this was switched on can never be
# summarised.
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=

# --- Fathom: the closer it records instead of Zoom (optional) -----------------
# Fathom sits in the meeting as a notetaker, so there is no passcode and no
# transcription setting that might have been off - if the call is in Fathom,
# its transcript exists. fathom.video -> Settings -> API.
# FATHOM_API_KEY=

# Card icon. An emoji is stored by Notion itself, so unlike a hosted image it
# cannot expire. Defaults to a microphone; NOTION_ICON_URL overrides it.
# NOTION_ICON_EMOJI=🎙️

# --- Stripe: payment links for lead packages (optional) ----------------------
# "@RYTE payment link $621 for 40 basic spanish leads" - RYTE shows the line
# the client will read, waits for the button, then makes the link. It reuses
# one that already exists rather than making a second.
#
# Make a RESTRICTED key: Developers -> API keys -> Create restricted key ->
# "Powering an integration you built". Set every section to None, then Write
# on exactly three: Payment links, Products, Prices. Nothing else - if this
# key ever leaks, what it can do is make a payment link.
#
# For the RingCentral suggestions to check payments, also give it Read (not
# Write) on Customers, Invoices, Charges and Checkout Sessions. Without them
# the suggestions still come; the ping just says "checked Stripe (couldn't)".
#
# Start in Test mode (rk_test_...) to see the whole flow without a payable
# link existing, then swap in the live key when the wording is right.
# STRIPE_API_KEY=rk_test_...

# --- Trello, for the daily board routine ---
# Key and token from https://trello.com/power-ups/admin (make a Power-Up,
# then Generate a new API key, then the Token link beside it).
# The board id is the short code in the board's URL:
#   trello.com/b/<THIS_BIT>/agent-lead-lab
# The "Watching ..." line under RYTE's name in Discord. Leave it empty
# for none. Write it as "listening: sales calls" to pick the verb -
# watching, playing, listening or competing. "custom: busy being cute"
# shows the line with no verb in front of it.
DISCORD_ACTIVITY=

# --- The SOP library ---
# A Notion page to hold the SOP database, shared with the integration
# (page -> ... -> Connections). RYTE makes the database on first use.
NOTION_SOP_PAGE_ID=
# The Discord channel that feeds it. Everything posted there gets filed.
# The SOP library that already existed. Read once into a local index so
# RYTE can answer on it; never written to. Leave empty if it is the same
# page as NOTION_SOP_PAGE_ID.
NOTION_LIBRARY_PAGE_ID=

# The Discord channel that feeds it. Everything posted there gets filed.
DISCORD_SOP_CHANNEL_IDS=

TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
# Walk the board itself: In Que -> Today at 9am, Today -> Quality Check at 6pm,
# and at 9pm carry whatever is still unticked onto tomorrow's cards. Off unless
# set, because it writes to a board four people work off every day, on a timer,
# whether or not anybody is looking. Without it, `@RYTE trello rollover` still
# does the same thing on request.
TRELLO_AUTO=
# File new agents as they land in In Que, all day. Separate from TRELLO_AUTO:
# the board moves happen three times a day and this happens whenever a client
# signs, so wanting one is not wanting the other. Without it,
# `@RYTE trello agents` does the same thing on request.
# Also watches for leads set up that nobody ordered, and for lines on a Lead
# Order card for a day the agent is not live - today's card and tomorrow's,
# and on a Friday the weekend's too. Both only report; neither writes.
TRELLO_AGENTS_AUTO=
# Watch the day's cards all day and offer what was tagged - in a comment or
# in a description - within the minute of it being written, instead of waiting
# for somebody to type `@RYTE trello tags`. It still never writes on its own:
# the list comes with the same button either way, and anybody on the team can
# press it.
TRELLO_TAGS_AUTO=
# Where the acquirer's chargeback notifications land. RYTE reads what he can
# off each one and flags it in the board channel - never in this one, which is
# the acquirer's record and is read by people who are not acting on it. He
# never writes or sends anything off a notice; the flag is all of it.
DISCORD_DISPUTE_CHANNEL_ID=
# Where RYTE says one has landed. Its own channel rather than the board's: a
# dispute is money and is nobody's daily routine, and on the board channel it
# arrives between a rollover and a list of tagged comments and gets scrolled
# past with them. Blank puts it with the board's own messages.
DISCORD_CHARGEBACK_CHANNEL_ID=
# The server the agents' own channels live in - Agent Lead Lab Clients, a
# different one from the team's. Banning somebody and deleting their channel
# both happen there, and naming it here means neither can happen anywhere else
# by mistake, whatever a command is pointed at.
DISCORD_CLIENTS_GUILD_ID=
# Where a deleted agent's sheet link is collected before their channel goes.
# Paste the whole link out of the browser bar, gid and all - the tab is
# resolved from the gid rather than typed, so a link is enough and nobody has
# to read the tab strip and copy what it says.
CLIENTS_SHEET_LINK=
# The Drive folder a screenshot of their channel goes into, as the whole link
# or just the folder id.
CLIENTS_DRIVE_FOLDER=
# The address the payment confirmations arrive from - AgentLeadLab@payra.com.
# Every Gmail search RYTE makes is pinned to it: it is the boundary of what he
# can read, not a convenience, and without it he searches nothing at all.
GMAIL_INVOICE_SENDER=
# Leave blank. PandaDoc does not email the signed PDF on this account - it is
# downloaded from PandaDoc - so there is nothing in any inbox for this to
# find. Only set it if contracts start arriving by email from somewhere.
GMAIL_CONTRACT_SENDER=
# RingCentral, READ ONLY. RYTE reads Faith's texts with the agents and pings
# you in Discord with the reply she would send. It cannot send a text: there
# is no send anywhere in the code, so nothing reaches an agent unless you
# send it yourself.
#
# One-time setup, as an admin, at developers.ringcentral.com:
#   1. Apps -> Create App -> "REST API App".
#   2. Auth: "JWT auth flow".
#   3. Security, permissions: Read Messages, Read Accounts. Nothing else.
#   4. Security: "private - only callable using credentials from the same
#      RingCentral account". Create. Copy the Client ID and Client Secret.
#   5. Your name (top right) -> Credentials -> Create JWT. Restrict it to
#      this app's Client ID. Copy the JWT - it is shown once.
# Paste all three here, on the Mac. Never into a chat.
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_JWT=
# The extension of the line Faith texts agents FROM - its number, as it
# reads in the admin portal, or its name. Not necessarily hers: here she
# texts from Arnold Tarpley's line, Ext. 101. The only extension RYTE reads.
RINGCENTRAL_EXTENSION=
# The Discord channel the suggestions go to - its name, "ryte-responder",
# or its id. RYTE's role needs View Channel and Send Messages there if it is
# private; if it can't post there it says so in the board channel instead.
# Blank uses the board channel.
RINGCENTRAL_CHANNEL_ID=
# A second screen: the same cards, lessons and playbook again in another
# channel - the team's server - with nobody @-tagged there. The channel above
# keeps its ping. Its id (right-click the channel, Copy Channel ID). Replies
# there teach RYTE the same as replies in the channel above. Blank: no copy.
RINGCENTRAL_SHARED_CHANNEL_ID=

# ---------------------------------------------------------- Ryte The Goat
# A full copy of RYTE in another server. Each pair is a channel RYTE talks in
# now and its twin there - original:copy, comma-separated. Everything posted
# in the original is posted in the twin too, edits and buttons included (a
# press in either answers it), and @Ryte works in the twins as it does in the
# originals. Right-click a channel -> Copy Channel ID for each side.
# DISCORD_COPIES=111111111111111111:222222222222222222,333333333333333333:444444444444444444
DISCORD_COPIES=
# true: people are tagged in the twins only. The originals still show "@Luna"
# but notify nobody - including teammates RYTE chases there, who then need to
# be in the twins' server to be told.
DISCORD_TAG_IN_COPIES_ONLY=
# Where RYTE's own news is copied - "Updating myself", "couldn't update",
# "is live" - instead of into the twin of the channel it is posted in. The
# channel it is posted in keeps getting it as before.
DISCORD_ANNOUNCE_COPY_CHANNEL_ID=
# Colleagues who text into the line from their own numbers, comma-separated,
# as RingCentral names them - never treated as an agent waiting on a reply.
# Anything under the line's own name is always one: Tre's cell, (412), is
# labelled "Arnold Tarpley" the same as the line.
RINGCENTRAL_TEAM=
# The number Faith texts from - (878). Only texts sent from it are learned as
# hers. Blank works it out: it's the number nearly everything goes out from.
# Several, comma-separated, when Franklin answers agents from another number
# on the line and those replies should be learned from too.
RINGCENTRAL_FAITH_NUMBER=
# Only when the invoices arrive at a different Google account than the one
# that owns the sheets. A refresh token belongs to one account, so this is
# that account's - minted against the same OAuth client above, which is the
# app rather than the person, so only the token changes. Leave blank when it
# is all one address.
GMAIL_REFRESH_TOKEN=
# And its own OAuth client, if the token above was minted against a different
# one than GOOGLE_CLIENT_ID. A refresh token belongs to the client it was
# minted under as much as to the person, and a project with several of them -
# Ryte, Ryte Leads - refuses the mismatch with "unauthorized_client" and
# nothing else to go on. Leave both blank when it is all one client.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Where the board's own messages go. Falls back to DISCORD_POST_CHANNEL_ID.
DISCORD_BOARD_CHANNEL_ID=

# --- The Levinson agency's monthly report ---
# Which of the agents Levinson sent us actually paid, and how much. RYTE reads
# Payra's payment notifications, keeps the ones belonging to a Levinson agent,
# and appends them to the tracker. It only ever appends.
#
# The channel Payra announces payments in. RYTE needs View Channel and Read
# Message History on it.
#
# Set, RYTE also watches it live: a payment from a Levinson agent is on the
# tracker within seconds of landing, and says so in one line. Everything else
# in the channel is ignored without a word. Setting this turns on the Message
# Content intent, which has to be switched on in the Developer Portal too -
# Payra's payment is another bot's embed in a channel that never mentions RYTE,
# and without the intent the fields arrive blank, which reads exactly like a
# month with no sales.
DISCORD_PAYMENT_CHANNEL_ID=
# The tracker: the long code out of its URL. Each month's rows go on the tab
# named for that month - "August", "August 2026", "Aug", "08/2026" all match -
# and a month with no tab yet gets one made, named the way the others are.
LEVINSON_SHEET_ID=
# The opt-in list kept by hand. A second source for who is Levinson's, so
# somebody the GHL tag missed still counts. Optional.
LEVINSON_OPTIN_SHEET_ID=
# The tag GoHighLevel puts on a contact who came in through Levinson's page.
# Spelled the way it is in GHL, which is not how Levinson spell it.
LEVINSON_TAG=levison leads

# Put every Trello and Google request back in the terminal window. Off by
# default: the agent watcher costs about sixteen requests every twenty
# seconds, so this is three thousand lines an hour of "200 OK" and a real
# error gets lost in it. Turn it on when a misbehaving API is what you're
# looking at.
# RYTE_LOG_HTTP=true
