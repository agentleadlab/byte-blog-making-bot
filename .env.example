# --- Anthropic (copy generation) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- GoHighLevel / LeadConnector ---
# Private Integration token for the Agent Lead Lab sub-account.
# Create under: Settings -> Private Integrations, with these scopes:
#   blogs/post.write, blogs/post-update.write, blogs/check-slug.readonly,
#   blogs/category.readonly, blogs/author.readonly, medias.write, medias.readonly
GHL_API_TOKEN=pit-...

# Agent Lead Lab sub-account location id (from the GHL URL: /v2/location/<THIS>/...)
GHL_LOCATION_ID=BKhr2W215aCl1bR6BHc5

# The "Agent Lead Lab Blogs" blog site id (from /blogs/site/<THIS>?tab=blog-posts)
GHL_BLOG_ID=vVS0DP09w5DdUY9AVVuA

# Optional: pin the author/category by id instead of resolving by name at runtime.
# GHL_AUTHOR_ID=
# GHL_CATEGORY_ID=
